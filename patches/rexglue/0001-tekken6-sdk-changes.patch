+  if (auto it = c.m.find(handle); it != c.m.end()) return object_ref<XObject>(it->second);
+  auto o = REX_KERNEL_OBJECTS()->LookupObject<XObject>(handle);
+  if (o && c.m.size() < 256) c.m.emplace(handle, object_ref<XObject>(o));
