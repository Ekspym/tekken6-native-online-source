+      max(float_x4_xe(-1.0f),
+          float4_xe(int4_xe(packed_texels) << 16 >> 16) * (1.0f / 32767.0f));
+  float4_xe g =
+      max(float_x4_xe(-1.0f),
+          float4_xe(int4_xe(packed_texels) >> 16) * (1.0f / 32767.0f));
+  return uint4_xe(pack_half_2x16_xe(float2_xe(r.x, g.x)),
+                  pack_half_2x16_xe(float2_xe(r.y, g.y)),
+                  pack_half_2x16_xe(float2_xe(r.z, g.z)),
+                  pack_half_2x16_xe(float2_xe(r.w, g.w)));
