+// T6_PRESENT_STATS=1 (input latency, 2026-10-17 "snizit input lag o 1 frame"): per 240 presents, the time from the
+// guest output refresh (the guest's swap reached the presenter) to Present, and from Present to the vblank the frame
+// was shown at (DXGI frame statistics: PresentCount / SyncQPCTime of the last displayed present), whether the
+// present ran on the guest output thread (immediate) or the UI thread, and the tearing flag.
+namespace {
+void T6PresentStats(IDXGISwapChain3* swap_chain, bool tearing) {
+  struct Rec { UINT count; int64_t qpc; };
+  static Rec ring[64] = {};
+  static int64_t freq = [] { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return f.QuadPart; }();
+  static double to_present_sum = 0, to_present_max = 0, to_display_sum = 0, to_display_max = 0;
+  static uint32_t n = 0, shown = 0, immediate = 0, no_stats = 0;
+  LARGE_INTEGER now;
+  QueryPerformanceCounter(&now);
+  UINT count = 0;
+  swap_chain->GetLastPresentCount(&count);
+  ring[count % 64] = {count, now.QuadPart};
+  const double tp = double(now.QuadPart - t6_guest_output_qpc.load(std::memory_order_relaxed)) * 1000.0 / double(freq);
+  to_present_sum += tp;
+  to_present_max = std::max(to_present_max, tp);
+  if (t6_guest_output_thread.load(std::memory_order_relaxed) == GetCurrentThreadId()) immediate++;
+  DXGI_FRAME_STATISTICS fs = {};
+  static UINT last_shown = 0;
+  if (SUCCEEDED(swap_chain->GetFrameStatistics(&fs))) {
+    const Rec& r = ring[fs.PresentCount % 64];
+    if (fs.PresentCount != last_shown && r.count == fs.PresentCount && fs.SyncQPCTime.QuadPart >= r.qpc) {
+      last_shown = fs.PresentCount;
+      const double td = double(fs.SyncQPCTime.QuadPart - r.qpc) * 1000.0 / double(freq);
+      to_display_sum += td;
+      to_display_max = std::max(to_display_max, td);
+      shown++;
+    }
+  } else {
+    no_stats++;
+  }
+  if (++n < 240) return;
+  REXLOG_INFO("T6 present: {} presents ({} from the guest output thread, tearing {}): guest output -> Present avg {:.2f} max {:.2f} ms; "
+              "Present -> shown avg {:.2f} max {:.2f} ms ({} measured, {} without frame statistics)",
+              n, immediate, tearing ? "on" : "off", to_present_sum / n, to_present_max, shown ? to_display_sum / shown : -1.0,
+              to_display_max, shown, no_stats);
+  to_present_sum = to_present_max = to_display_sum = to_display_max = 0;
+  n = shown = immediate = no_stats = 0;
+}
