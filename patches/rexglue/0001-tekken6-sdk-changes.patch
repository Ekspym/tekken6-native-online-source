+// Netplay (PS3 port: wait for SPURS jobs before a save/load): number of threads blocked in NtWaitForSingleObjectEx per
+// handle, read by rex_waiters (the game's job workers all waiting on the job semaphore = no job running)
+// 2026-10-11: these counts were three maps behind one mutex, taken twice by EVERY wait of every thread (the job
+// workers wake together and all met there). Now a fixed table of atomics, found by the key without a lock; a key
+// keeps its slot for good (handles and object addresses repeat), a full table counts nothing.
+namespace {
+struct T6WaitSlot {
+  std::atomic<uint32_t> key{0};
+  std::atomic<int32_t> waiters{0};
+  std::atomic<uint64_t> entries{0};  // waits begun on the key
+  std::atomic<void*> ctx{nullptr};   // guest context of the last thread that began a wait on it
+};
+constexpr uint32_t kT6WaitSlots = 8192;
+T6WaitSlot g_wait_slots[kT6WaitSlots];
+T6WaitSlot* T6WaitSlotOf(uint32_t key, bool create) {
+  if (!key) return nullptr;
+  uint32_t i = (key * 0x9E3779B1u) >> 19;
+  for (uint32_t n = 0; n < kT6WaitSlots; n++, i = (i + 1) & (kT6WaitSlots - 1)) {
+    uint32_t k = g_wait_slots[i].key.load(std::memory_order_acquire);
+    if (k == key) return &g_wait_slots[i];
+    if (k == 0) {
+      if (!create) return nullptr;
+      if (g_wait_slots[i].key.compare_exchange_strong(k, key) || k == key) return &g_wait_slots[i];
+    }
+  }
+  return nullptr;
+}
+void T6WaitBegin(uint32_t key) {
+  if (T6WaitSlot* s = T6WaitSlotOf(key, true)) {
+    if (auto* ts = rex::runtime::ThreadState::Get(); ts && ts->context()) s->ctx.store(ts->context(), std::memory_order_relaxed);
+    s->entries.fetch_add(1, std::memory_order_relaxed);
+    s->waiters.fetch_add(1);
+  }
+}
+void T6WaitEnd(uint32_t key) {
+  if (T6WaitSlot* s = T6WaitSlotOf(key, false)) s->waiters.fetch_sub(1);
+}
+
+// TEKKEN6_WAIT_STACK=<handle hex> or * (every handle): guest call stack (LR + back chain) of the waits, each distinct
+// handle + stack logged once (where a thread blocks, e.g. a hang after a netplay restore)
+void T6WaitStack(const char* what, uint32_t handle) {
+  static const char* ws = std::getenv("TEKKEN6_WAIT_STACK");
+  if (!ws || (*ws != '*' && std::strtoul(ws, nullptr, 16) != handle)) return;
+  auto* thread_state = rex::runtime::ThreadState::Get();
+  auto* context = thread_state ? thread_state->context() : nullptr;
+  if (!context) return;
+  auto* mem = REX_KERNEL_MEMORY();
+  std::string chain;
+  uint32_t sp = context->r1.u32;
+  const uint32_t top = mem->TranslateVirtual<X_KPCR*>(static_cast<uint32_t>(context->r13.u64))->stack_base_ptr;
+  for (int i = 0; i < 14 && sp >= 0x70000000u && sp < top; i++) {
+    const uint32_t next = rex::memory::load_and_swap<uint32_t>((mem->virtual_membase() + sp));
+    if (next <= sp || next - sp > 0x10000u || next >= top) break;
+    chain += fmt::format(" {:08X}", rex::memory::load_and_swap<uint32_t>((mem->virtual_membase() + next - 8)));
+    sp = next;
+  }
+  const std::string key = fmt::format("{:08X}{:08X}{}", handle, static_cast<uint32_t>(context->lr), chain);
+  static std::mutex seen_mutex;
+  static std::vector<std::string> seen;
+  {
+    std::lock_guard lock(seen_mutex);
+    if (std::find(seen.begin(), seen.end(), key) != seen.end()) return;
+    seen.push_back(key);
+  }
+  REXKRNL_INFO("[Tekken6] {} stack handle={:08X} lr={:08X} r3={:08X} r28-31={:08X},{:08X},{:08X},{:08X} chain:{}", what,
+               handle, static_cast<uint32_t>(context->lr), context->r3.u32, context->r28.u32, context->r29.u32,
+               context->r30.u32, context->r31.u32, chain);
+}
+}  // namespace
+void T6WaiterAdd(uint32_t key, int d) {
+  if (d > 0) T6WaitBegin(key);
+  else T6WaitEnd(key);
+}
