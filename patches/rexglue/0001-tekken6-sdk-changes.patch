+  struct Cache {
+    uint32_t gen = ~0u;
+    std::unordered_map<uint32_t, object_ref<XObject>> m;
+  };
+  thread_local Cache c;
+  const uint32_t g = rex::system::util::t6_handle_gen.load(std::memory_order_acquire);
+  if (c.gen != g) {
+    c.m.clear();
+    c.gen = g;
