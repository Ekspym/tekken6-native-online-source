+constexpr ButtonTarget kButtons[15] = {
+    {"A", X_INPUT_GAMEPAD_A},          {"B", X_INPUT_GAMEPAD_B},
+    {"X", X_INPUT_GAMEPAD_X},          {"Y", X_INPUT_GAMEPAD_Y},
+    {"LB", X_INPUT_GAMEPAD_LEFT_SHOULDER}, {"RB", X_INPUT_GAMEPAD_RIGHT_SHOULDER},
+    {"Back", X_INPUT_GAMEPAD_BACK},    {"Start", X_INPUT_GAMEPAD_START},
+    {"LS", X_INPUT_GAMEPAD_LEFT_THUMB}, {"RS", X_INPUT_GAMEPAD_RIGHT_THUMB},
+    {"Guide", X_INPUT_GAMEPAD_GUIDE},  {"Up", X_INPUT_GAMEPAD_DPAD_UP},
+    {"Down", X_INPUT_GAMEPAD_DPAD_DOWN}, {"Left", X_INPUT_GAMEPAD_DPAD_LEFT},
+    {"Right", X_INPUT_GAMEPAD_DPAD_RIGHT},
+};
+constexpr const char* kTriggers[2] = {"LT", "RT"};
+constexpr const char* kSticks[8] = {"Left Stick Left",  "Left Stick Right",  "Left Stick Down",  "Left Stick Up",
+                                    "Right Stick Left", "Right Stick Right", "Right Stick Down", "Right Stick Up"};
+
+// Defaults = the user's RPCS3 MMJoystick profile (Razer Panthera PS4), PS3 positions on the Xbox ones
+// (Square->X, Cross->A, Circle->B, Triangle->Y)
+constexpr const char* kDefaultConfig =
+    "; Tekken 6 (ReXGlue) - MMJoystick mapping, like RPCS3's MMJoystick handler\n"
+    "; target = source | source ...   sources: Button N, POV Up/Down/Left/Right, X+ X- Y+ Y- Z+ Z- R+ R- U+ U- V+ V-\n"
+    "; WinMM axes grow downwards: stick up = Y- / R-\n"
+    "Device = 1\n"
+    "A = Button 2\n"
+    "B = Button 3\n"
+    "X = Button 1\n"
+    "Y = Button 4\n"
+    "LB = Button 5\n"
+    "RB = Button 6\n"
+    "LT = Button 7\n"
+    "RT = Button 8\n"
+    "Back = Button 9\n"
+    "Start = Button 10\n"
+    "LS = Button 11\n"
+    "RS = Button 12\n"
+    "Guide = Button 13 | Button 17\n"
+    "Up = POV Up\n"
+    "Down = POV Down\n"
+    "Left = POV Left\n"
+    "Right = POV Right\n"
+    "Left Stick Left = X-\n"
+    "Left Stick Right = X+\n"
+    "Left Stick Down = Y+\n"
+    "Left Stick Up = Y-\n"
+    "Right Stick Left = Z-\n"
+    "Right Stick Right = Z+\n"
+    "Right Stick Down = R+\n"
+    "Right Stick Up = R-\n";
+
+std::string Trim(std::string s) {
+  const auto b = s.find_first_not_of(" \t\r\n");
+  const auto e = s.find_last_not_of(" \t\r\n");
+  return b == std::string::npos ? std::string() : s.substr(b, e - b + 1);
+}
+
+bool EqualNoCase(const std::string& a, const char* b) {
+  return a.size() == std::strlen(b) &&
+         std::equal(a.begin(), a.end(), b, [](char x, char y) { return std::tolower(x) == std::tolower(y); });
+}
+
+bool ParseSource(const std::string& text, MMJoystickInputDriver::Source& out) {
+  using Kind = MMJoystickInputDriver::Source::Kind;
+  std::string t = Trim(text);
+  if (t.empty()) return false;
+  std::string lower = t;
+  std::transform(lower.begin(), lower.end(), lower.begin(), [](char c) { return std::tolower(c); });
+  if (lower.rfind("button", 0) == 0) {
+    const int n = std::atoi(lower.c_str() + 6);
+    if (n < 1 || n > 32) return false;
+    out = {Kind::kButton, static_cast<uint32_t>(n)};
+    return true;
+  }
+  if (lower.rfind("pov", 0) == 0) {
+    const std::string d = Trim(lower.substr(3));
+    const char* dirs[4] = {"up", "right", "down", "left"};
+    for (uint32_t i = 0; i < 4; i++) {
+      if (d == dirs[i]) {
+        out = {Kind::kPov, i};
+        return true;
+      }
+    }
+    return false;
+  }
+  if (lower.size() == 2 && (lower[1] == '+' || lower[1] == '-')) {
+    const char* axes = "xyzruv";
+    const char* p = std::strchr(axes, lower[0]);
+    if (!p) return false;
+    out = {lower[1] == '+' ? Kind::kAxisPos : Kind::kAxisNeg, static_cast<uint32_t>(p - axes)};
+    return true;
+  }
+  return false;
+}
+
+std::filesystem::path ConfigPath() {
+  const std::string cv = REXCVAR_GET(mmjoystick_config);
+  if (!cv.empty()) return std::filesystem::path(cv);
+  wchar_t exe[MAX_PATH] = {};
+  GetModuleFileNameW(nullptr, exe, MAX_PATH);
+  return std::filesystem::path(exe).parent_path() / "mmjoystick.ini";
+}
+
+// Axis deflection 0..1 in the bound direction, from the raw WinMM position and the device range
+float AxisHalf(const JOYINFOEX& info, const JOYCAPSW& caps, uint32_t axis, bool positive) {
+  DWORD v = 0;
+  UINT lo = 0, hi = 65535;
+  switch (axis) {
+    case 0: v = info.dwXpos; lo = caps.wXmin; hi = caps.wXmax; break;
+    case 1: v = info.dwYpos; lo = caps.wYmin; hi = caps.wYmax; break;
+    case 2: v = info.dwZpos; lo = caps.wZmin; hi = caps.wZmax; break;
+    case 3: v = info.dwRpos; lo = caps.wRmin; hi = caps.wRmax; break;
+    case 4: v = info.dwUpos; lo = caps.wUmin; hi = caps.wUmax; break;
+    case 5: v = info.dwVpos; lo = caps.wVmin; hi = caps.wVmax; break;
+  }
+  if (hi <= lo) return 0.0f;
+  const float center = (static_cast<float>(lo) + static_cast<float>(hi)) * 0.5f;
+  const float half = (static_cast<float>(hi) - static_cast<float>(lo)) * 0.5f;
+  float d = (static_cast<float>(v) - center) / half;
+  if (!positive) d = -d;
+  return std::clamp(d, 0.0f, 1.0f);
+}
+
+}  // namespace
+
+MMJoystickInputDriver::MMJoystickInputDriver(rex::ui::Window* window, size_t window_z_order)
+    : InputDriver(window, window_z_order) {}
+
+MMJoystickInputDriver::~MMJoystickInputDriver() {
+  poll_stop_ = true;
+  if (poll_thread_.joinable()) poll_thread_.join();
+}
+
+void MMJoystickInputDriver::PollLoop() {
+  uint32_t prev_buttons = 0;
+  while (!poll_stop_) {
+    JOYINFOEX info{};
+    info.dwSize = sizeof(info);
+    info.dwFlags = JOY_RETURNBUTTONS | JOY_RETURNPOV;
+    if (joyGetPosEx(joy_id_, &info) == JOYERR_NOERROR) {
+      std::lock_guard<std::mutex> lock(latch_mutex_);
+      latched_buttons_ |= info.dwButtons & ~prev_buttons;
+      prev_buttons = info.dwButtons;
+      if (info.dwPOV != JOY_POVCENTERED) latched_pov_ = info.dwPOV;
+    }
+    Sleep(1);
+  }
+}
+
+void MMJoystickInputDriver::WriteDefaultConfig(const std::string& path) {
+  std::ofstream f(path, std::ios::binary);
+  if (f) {
+    f << kDefaultConfig;
+    REXLOG_INFO("MMJoystick: wrote default mapping {}", path);
+  }
+}
+
+bool MMJoystickInputDriver::LoadConfig() {
+  const auto path = ConfigPath();
+  if (!std::filesystem::exists(path)) {
+    WriteDefaultConfig(path.string());
+  }
+  std::stringstream text;
+  if (std::ifstream f(path, std::ios::binary); f) {
+    text << f.rdbuf();
+  } else {
+    text << kDefaultConfig;
+  }
+
+  for (auto& b : buttons_) b.sources.clear();
+  for (auto& b : triggers_) b.sources.clear();
+  for (auto& b : sticks_) b.sources.clear();
+
+  std::string line;
+  while (std::getline(text, line)) {
+    if (const auto c = line.find(';'); c != std::string::npos) line.resize(c);
+    const auto eq = line.find('=');
+    if (eq == std::string::npos) continue;
+    const std::string key = Trim(line.substr(0, eq));
+    const std::string value = Trim(line.substr(eq + 1));
+    if (EqualNoCase(key, "Device")) {
+      joy_id_ = static_cast<uint32_t>(std::max(1, std::atoi(value.c_str())) - 1);
+      continue;
+    }
+    Binding* target = nullptr;
+    for (size_t i = 0; i < 15 && !target; i++) {
+      if (EqualNoCase(key, kButtons[i].key)) target = &buttons_[i];
+    }
+    for (size_t i = 0; i < 2 && !target; i++) {
+      if (EqualNoCase(key, kTriggers[i])) target = &triggers_[i];
+    }
+    for (size_t i = 0; i < 8 && !target; i++) {
+      if (EqualNoCase(key, kSticks[i])) target = &sticks_[i];
+    }
+    if (!target) {
+      REXLOG_WARN("MMJoystick: unknown target '{}' in {}", key, path.string());
+      continue;
+    }
+    std::stringstream parts(value);
+    std::string part;
+    while (std::getline(parts, part, '|')) {
+      // RPCS3 writes alternatives as "Button 8&U+"
+      std::stringstream amp(part);
+      std::string one;
+      while (std::getline(amp, one, '&')) {
+        Source s;
+        if (ParseSource(one, s)) {
+          target->sources.push_back(s);
+        } else if (!Trim(one).empty()) {
+          REXLOG_WARN("MMJoystick: bad source '{}' for '{}'", Trim(one), key);
+        }
+      }
+    }
+  }
+  REXLOG_INFO("MMJoystick: mapping {} (device {})", path.string(), joy_id_ + 1);
+  return true;
+}
+
+X_STATUS MMJoystickInputDriver::Setup() {
+  LoadConfig();
+  JOYCAPSW caps{};
+  if (joyGetDevCapsW(joy_id_, &caps, sizeof(caps)) == JOYERR_NOERROR) {
+    char name[64] = {};
+    WideCharToMultiByte(CP_UTF8, 0, caps.szPname, -1, name, sizeof(name) - 1, nullptr, nullptr);
+    device_name_ = name;
+    REXLOG_INFO("MMJoystick: device {} '{}', {} buttons, {} axes, POV {}", joy_id_ + 1, device_name_,
+                caps.wNumButtons, caps.wNumAxes, (caps.wCaps & JOYCAPS_HASPOV) ? "yes" : "no");
+    if (!poll_thread_.joinable()) poll_thread_ = std::thread([this] { PollLoop(); });  // (presses between reads)
+  } else {
+    REXLOG_WARN("MMJoystick: device {} not found (connect it before starting)", joy_id_ + 1);
+  }
+  return X_STATUS_SUCCESS;
+}
+
+void MMJoystickInputDriver::EnumerateDevices(std::vector<DeviceInfo>& out) {
+  JOYINFOEX info{};
+  info.dwSize = sizeof(info);
+  info.dwFlags = JOY_RETURNALL;
+  if (joyGetPosEx(joy_id_, &info) != JOYERR_NOERROR) {
+    return;
+  }
+  DeviceInfo d;
+  d.id = kDevice;
+  d.name = device_name_.empty() ? std::string("MMJoystick") : device_name_;
+  d.guid = "mmjoystick-" + std::to_string(joy_id_ + 1);
+  out.push_back(d);
+}
+
+X_RESULT MMJoystickInputDriver::GetDeviceCapabilities(DeviceId id, uint32_t flags,
+                                                     X_INPUT_CAPABILITIES* out_caps) {
+  if (id != kDevice) return X_ERROR_DEVICE_NOT_CONNECTED;
+  if (out_caps) {
+    std::memset(out_caps, 0, sizeof(*out_caps));
+    out_caps->type = 0x01;      // XINPUT_DEVTYPE_GAMEPAD
+    out_caps->sub_type = 0x01;  // XINPUT_DEVSUBTYPE_GAMEPAD
+    out_caps->gamepad.buttons = 0xFFFF;
+    out_caps->gamepad.left_trigger = 0xFF;
+    out_caps->gamepad.right_trigger = 0xFF;
+    out_caps->gamepad.thumb_lx = static_cast<int16_t>(0x7FFF);
+    out_caps->gamepad.thumb_ly = static_cast<int16_t>(0x7FFF);
+    out_caps->gamepad.thumb_rx = static_cast<int16_t>(0x7FFF);
+    out_caps->gamepad.thumb_ry = static_cast<int16_t>(0x7FFF);
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT MMJoystickInputDriver::GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) {
+  if (id != kDevice) return X_ERROR_DEVICE_NOT_CONNECTED;
+
+  JOYINFOEX info{};
+  info.dwSize = sizeof(info);
+  info.dwFlags = JOY_RETURNALL;
+  if (joyGetPosEx(joy_id_, &info) != JOYERR_NOERROR) {
+    return X_ERROR_DEVICE_NOT_CONNECTED;
+  }
+  {
+    // (tekken6-x360: what the poll thread saw pressed since the last read, see poll_thread_)
+    std::lock_guard<std::mutex> lock(latch_mutex_);
+    info.dwButtons |= latched_buttons_;
+    if (info.dwPOV == JOY_POVCENTERED && latched_pov_ != JOY_POVCENTERED) info.dwPOV = latched_pov_;
+    latched_buttons_ = 0;
+    latched_pov_ = JOY_POVCENTERED;
+  }
+  static JOYCAPSW caps{};
+  static bool caps_ok = false;
+  if (!caps_ok) {
+    caps_ok = joyGetDevCapsW(joy_id_, &caps, sizeof(caps)) == JOYERR_NOERROR;
+  }
+
+  // 0..1 value of one source
+  const auto value = [&](const Source& s) -> float {
+    switch (s.kind) {
+      case Source::Kind::kButton:
+        return (info.dwButtons >> (s.index - 1)) & 1 ? 1.0f : 0.0f;
+      case Source::Kind::kPov: {
+        if (info.dwPOV == JOY_POVCENTERED || info.dwPOV > 35900) return 0.0f;
+        // 8-way: a direction is active within +-67.5 degrees (diagonals press both)
+        const float target = static_cast<float>(s.index) * 9000.0f;
+        float diff = std::fabs(static_cast<float>(info.dwPOV) - target);
+        diff = std::min(diff, 36000.0f - diff);
+        return diff <= 6750.0f ? 1.0f : 0.0f;
+      }
+      case Source::Kind::kAxisPos:
+        return caps_ok ? AxisHalf(info, caps, s.index, true) : 0.0f;
+      case Source::Kind::kAxisNeg:
+        return caps_ok ? AxisHalf(info, caps, s.index, false) : 0.0f;
+    }
+    return 0.0f;
+  };
+  const auto level = [&](const Binding& b) {
+    float v = 0.0f;
+    for (const auto& s : b.sources) v = std::max(v, value(s));
+    return v;
+  };
+
+  uint16_t buttons = 0;
+  for (size_t i = 0; i < buttons_.size(); i++) {
+    if (level(buttons_[i]) > 0.5f) buttons |= kButtons[i].mask;
+  }
+  const auto stick = [&](size_t neg, size_t pos) {
+    const float v = level(sticks_[pos]) - level(sticks_[neg]);
+    return static_cast<int16_t>(std::clamp(v, -1.0f, 1.0f) * 32767.0f);
+  };
+
+  if (out_state) {
+    std::memset(out_state, 0, sizeof(*out_state));
+    out_state->packet_number = ++packet_number_;
+    out_state->gamepad.buttons = buttons;
+    out_state->gamepad.left_trigger = static_cast<uint8_t>(level(triggers_[0]) * 255.0f);
+    out_state->gamepad.right_trigger = static_cast<uint8_t>(level(triggers_[1]) * 255.0f);
+    out_state->gamepad.thumb_lx = stick(0, 1);
+    out_state->gamepad.thumb_ly = stick(2, 3);
+    out_state->gamepad.thumb_rx = stick(4, 5);
+    out_state->gamepad.thumb_ry = stick(6, 7);
+  }
+  return X_ERROR_SUCCESS;
+}
+
+X_RESULT MMJoystickInputDriver::SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* /*vibration*/) {
+  return id == kDevice ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+}
+
+X_RESULT MMJoystickInputDriver::GetDeviceKeystroke(DeviceId id, uint32_t /*flags*/,
+                                                  X_INPUT_KEYSTROKE* /*out_keystroke*/) {
+  return id == kDevice ? X_ERROR_EMPTY : X_ERROR_DEVICE_NOT_CONNECTED;
+}
