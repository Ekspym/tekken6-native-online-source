+// Netplay diagnostics: name and guest context of the thread whose KTHREAD is at guest address `kthread` (owner field of
+// a critical section). Returns the PPCContext* or nullptr; the name is copied into `name`.
+#include <rex/system/kernel_state.h>
+#include <rex/system/xthread.h>
+extern "C" __declspec(dllexport) void* rex_thread_by_kthread(uint32_t kthread, char* name, uint32_t name_size) {
+  auto* ks = rex::system::kernel_state();
+  if (!ks) return nullptr;
