+// Opt-in startup I/O boundary trace. One slot covers request and completion,
+// so a busy title cannot turn a short diagnostic run into an unbounded log.
+static std::atomic<uint32_t> tekken6_io_trace_count{0};
+static std::atomic<uint64_t> tekken6_movie_io_trace_count{0};
+static int Tekken6IoTraceSlot() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("TEKKEN6_TRACE_IO");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  if (!enabled) return -1;
+  const uint32_t slot = tekken6_io_trace_count.fetch_add(1, std::memory_order_relaxed);
+  return slot < 256 ? static_cast<int>(slot) : -1;
+}
+
+static uint32_t Tekken6IoCaller() {
+  auto* state = rex::runtime::ThreadState::Get();
+  const uint64_t lr = state ? state->context()->lr : 0;
+  // Imports are called with a branch-and-link; LR - 4 is the call site.
+  return lr >= 4 ? static_cast<uint32_t>(lr - 4) : 0;
+}
+
+static uint32_t Tekken6IoThread() {
+  auto* state = rex::runtime::ThreadState::Get();
+  return state ? state->thread_id() : 0;
+}
+
+static uint32_t Tekken6IoLoadU32(uint32_t guest_address) {
+  if (!guest_address) return 0;
+  auto* host_address = REX_KERNEL_MEMORY()->TranslateVirtual<uint8_t*>(guest_address);
+  return memory::load_and_swap<uint32_t>(host_address);
+}
+
+static bool Tekken6MovieIoTraceEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("TEKKEN6_TRACE_MOVIE");
+    return value && std::strcmp(value, "0") != 0;
+  }();
+  return enabled;
+}
+
+static bool Tekken6IsMovieBank(const XFile* file) {
+  if (!file) return false;
+  const auto& name = file->name();
+  return name == "DATA315.BIN" || name == "DATA316.BIN" || name == "DATA317.BIN" ||
+         name == "DATA318.BIN" || name == "DATA319.BIN" || name == "DATA320.BIN";
+}
