+    uint8_t* mb = REX_KERNEL_MEMORY()->virtual_membase();
+    auto readable = [](const void* p) {
+      MEMORY_BASIC_INFORMATION mbi{};
+      return VirtualQuery(p, &mbi, sizeof(mbi)) && mbi.State == MEM_COMMIT &&
+             !(mbi.Protect & (PAGE_NOACCESS | PAGE_GUARD));
+    };
+    uint32_t sp = ctx->r1.u32;
+    for (int i = 0; i < 8 && sp; i++) {
+      if (!readable(mb + sp)) break;
+      const uint32_t next = rex::memory::load_and_swap<uint32_t>(mb + sp);
+      if (next <= sp || next - sp > 0x10000 || !readable(mb + next - 8)) break;
+      chain += fmt::format(" {:08X}", rex::memory::load_and_swap<uint32_t>(mb + next - 8));
+      sp = next;
+    }
+  }
+  REXKRNL_INFO("[T6ALLOC] {} addr={:08X} size={:08X} lr={:08X} chain:{}", what, addr, size,
+               ctx ? static_cast<uint32_t>(ctx->lr) : 0u, chain);
