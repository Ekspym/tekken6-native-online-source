+// ---- Live guest objects (netplay save/restore) ----
+// Guest structures whose bytes describe live kernel state: dispatcher headers linked to a host object (signature +
+// handle stashed by StashHandle) and critical sections (lock count, owner). A rollback must keep their current bytes:
+// restoring them brings back stale owners / handles (the PS3 port's lwmutex problem: the game hangs).
+namespace rex::system {
+namespace {
+std::mutex& LiveMutex() {
+  static std::mutex m;
+  return m;
+}
+std::map<uint32_t, uint32_t>& LiveMap() {
+  static std::map<uint32_t, uint32_t> m;
+  return m;
+}
+}  // namespace
+
+void RegisterLiveGuestObject(uint32_t guest_address, uint32_t size) {
+  if (!guest_address) return;
+  std::lock_guard lock(LiveMutex());
+  auto& m = LiveMap();
+  auto [it, inserted] = m.emplace(guest_address, size);
+  if (!inserted && it->second < size) it->second = size;
+}
+}  // namespace rex::system
+
+// Copies up to max_pairs (address, size) pairs to out, returns the total count
+extern "C" __declspec(dllexport) uint32_t rex_live_guest_objects(uint32_t* out, uint32_t max_pairs) {
+  std::lock_guard lock(rex::system::LiveMutex());
+  const auto& m = rex::system::LiveMap();
+  uint32_t n = 0;
+  for (const auto& [a, sz] : m) {
+    if (n < max_pairs && out) {
+      out[n * 2] = a;
+      out[n * 2 + 1] = sz;
+    }
+    n++;
+  }
+  return n;
+}
+
