+        sample_1 = float4_xe(unpack_half_2x16_xe(packed.y), 0.0f, 0.0f);
+        break;
+      default:
+        // Treat as 32_FLOAT.
+        sample_0 = float2_xe(uint_bits_to_float_xe(packed.x), 0.0f).xyyy;
+        sample_1 = float2_xe(uint_bits_to_float_xe(packed.y), 0.0f).xyyy;
+        break;
+    }
+  }
