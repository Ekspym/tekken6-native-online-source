+                       logical_name.c_str(),
+                       static_cast<unsigned long long>(offset), length,
+                       static_cast<unsigned long long>(*source_offset));
+        }
+        return true;
+      }
+    }
+    if (comma == std::string::npos) break;
+    begin = comma + 1;
+  }
+  return false;
