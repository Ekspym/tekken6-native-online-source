diff --git a/include/rex/input/mmjoystick/mmjoystick_input_driver.h b/include/rex/input/mmjoystick/mmjoystick_input_driver.h
new file mode 100644
index 0000000..b0b6f69
--- /dev/null
+++ b/include/rex/input/mmjoystick/mmjoystick_input_driver.h
@@ -0,0 +1,64 @@
+/**
+ * @file        input/mmjoystick/mmjoystick_input_driver.h
+ * @brief       WinMM joystick (joyGetPosEx) input driver - the "MMJoystick" handler of RPCS3, for devices SDL maps
+ *              wrongly (e.g. arcade sticks reported as PS4 pads). Mapping in mmjoystick.ini next to the executable.
+ */
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <mutex>
+#include <thread>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <rex/input/input_driver.h>
+
+namespace rex::input::mmjoystick {
+
+class MMJoystickInputDriver final : public InputDriver {
+ public:
+  explicit MMJoystickInputDriver(rex::ui::Window* window, size_t window_z_order);
+  ~MMJoystickInputDriver() override;
+
+  X_STATUS Setup() override;
+  void EnumerateDevices(std::vector<DeviceInfo>& out) override;
+  X_RESULT GetDeviceState(DeviceId id, X_INPUT_STATE* out_state) override;
+  X_RESULT GetDeviceCapabilities(DeviceId id, uint32_t flags, X_INPUT_CAPABILITIES* out_caps) override;
+  X_RESULT SetDeviceVibration(DeviceId id, X_INPUT_VIBRATION* vibration) override;
+  X_RESULT GetDeviceKeystroke(DeviceId id, uint32_t flags, X_INPUT_KEYSTROKE* out_keystroke) override;
+
+  // One physical input: a button, a POV direction or an axis half (+/-)
+  struct Source {
+    enum class Kind { kButton, kPov, kAxisPos, kAxisNeg } kind = Kind::kButton;
+    uint32_t index = 0;  // button number (1-based) / POV direction 0..3 (up,right,down,left) / axis 0..5 (X,Y,Z,R,U,V)
+  };
+
+ private:
+  struct Binding {
+    std::vector<Source> sources;  // any of them
+  };
+
+  bool LoadConfig();
+  void WriteDefaultConfig(const std::string& path);
+
+  uint32_t joy_id_ = 0;  // WinMM joystick id ("Device = 1" -> 0)
+  // tekken6-x360 (user 2026-10-17: "stisknuti 4 ms uz je stisknuti ... to tam musi byt"): the stick is also read every
+  // millisecond by poll_thread_; every button / POV direction pressed since the last GetDeviceState is reported by it
+  // once, even when it was released before that read (a tap of a few ms between two reads of the game).
+  void PollLoop();
+  std::thread poll_thread_;
+  std::atomic<bool> poll_stop_{false};
+  std::mutex latch_mutex_;
+  uint32_t latched_buttons_ = 0;  // pressed since the last read (WinMM button bits)
+  uint32_t latched_pov_ = 0xFFFF;  // the last POV direction held since the last read (JOY_POVCENTERED = none)
+  std::string device_name_;
+  uint32_t packet_number_ = 0;
+  // buttons in the order of kButtonNames, then LT, RT, then the 8 stick half-axes
+  std::array<Binding, 15> buttons_;
+  std::array<Binding, 2> triggers_;
+  std::array<Binding, 8> sticks_;  // LS left, right, down, up, RS left, right, down, up
+};
+
+}  // namespace rex::input::mmjoystick
