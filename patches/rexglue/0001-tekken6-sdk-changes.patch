+// Assuming the original number has only 11 bits.
+uint2_xe XeSNorm11To16(uint2_xe s11) {
+  uint2_xe signs = s11 >> 10u;
+  bool2_xe is_negative = not_equal_xe(signs, uint_x2_xe(0u));
+  // -1024 and -1023 are both -1.0, but with -1024 the conversion will overflow.
+  s11 = select_xe(equal_xe(s11, uint_x2_xe(0x400u)), uint_x2_xe(0x401u), s11);
+  // Take the absolute value.
+  s11 = (s11 ^ select_xe(is_negative, uint_x2_xe(0x7FFu), uint_x2_xe(0u))) +
+        signs;
+  // Expand the 10-bit absolute value to 15 bits like unorm.
+  s11 = (s11 << 5u) | (s11 >> 5u);
